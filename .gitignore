# What git must not track: installed dependencies, build output, caches, local environment files, logs, OS and editor files, and the localnet's keystores.
# (`dist/` is produced by `npm run build` for the declarations; the package ships its source, so nothing in it is committed.)

# Dependencies
node_modules/

# Build output
dist/
build/

# Type-check cache
*.tsbuildinfo

# Test output
coverage/
.vitest-cache/

# Environment: local settings and secrets never belong in git (an example file may be committed).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Localnet keypairs — never commit real keys; these are test-only and gitignored
localnet/*.key
localnet/**/sui.keystore
